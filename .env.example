# ============================================
# Antigravity Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=<REDACTED>
POSTGRES_PASSWORD=<REDACTED>
POSTGRES_DB=custom_app

# --- Redis ---
REDIS_PASSWORD=<REDACTED>

# --- Grafana ---
GRAFANA_PASSWORD=<REDACTED>

# --- ABM MS SQL Server (Legacy Source) ---
ABM_MSSQL_HOST=<REDACTED>
ABM_MSSQL_DATABASE=mpgtrial
ABM_MSSQL_USER=<REDACTED>
ABM_MSSQL_PASSWORD=<REDACTED>

# --- Custom API ---
JWT_SECRET=<REDACTED>
DEV_ADMIN_PASSWORD=<REDACTED>
DEV_VIEWER_PASSWORD=<REDACTED>
CORS_ORIGINS=http://localhost:4300,http://localhost:4400

# --- Report Generation ---
# On Windows, provide absolute path to typst.exe if not on system PATH
# Example: TYPST_BINARY_PATH=C:\Users\...\typst.exe
TYPST_BINARY_PATH=typst
