# ============================================
# HeroBM Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# Or run: .\scripts\init-env.ps1 (auto-generates local secrets)
# NEVER commit .env to source control.
# ============================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REDACTED>
POSTGRES_DB=custom_app

# --- Redis ---
REDIS_PASSWORD=<REDACTED>

# --- Grafana ---
GRAFANA_PASSWORD=<REDACTED>

# --- Custom API ---
JWT_SECRET=<REDACTED>
DEV_ADMIN_PASSWORD=<REDACTED>
DEV_VIEWER_PASSWORD=<REDACTED>
DEV_SALES_PASSWORD=<REDACTED>
DEV_WAREHOUSE_PASSWORD=<REDACTED>
DEV_PROCUREMENT_PASSWORD=<REDACTED>
DEV_FINANCE_PASSWORD=<REDACTED>
CORS_ORIGINS=http://localhost:4300,http://localhost:4400

# --- Report Generation ---
# On Windows, provide absolute path to typst.exe if not on system PATH
# Example: TYPST_BINARY_PATH=C:\Users\...\typst.exe
TYPST_BINARY_PATH=typst

# --- Portal Support Contact (shown on error pages) ---
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- ERPNext (Financial Core) ---
ERPNEXT_VERSION=v16
ERPNEXT_DB_ROOT_PASSWORD=<REDACTED>
ERPNEXT_DB_PASSWORD=<REDACTED>
ERPNEXT_ADMIN_PASSWORD=<REDACTED>
ERPNEXT_REDIS_PASSWORD=<REDACTED>
ERPNEXT_URL=http://erpnext-backend:8000
ERPNEXT_API_KEY=<REDACTED>
ERPNEXT_API_SECRET=<REDACTED>

