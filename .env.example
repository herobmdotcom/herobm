# ============================================
# HeroBM Platform — Environment Variables
# ============================================
# Sets the basic configuration. Do one of:
# a) Run make cli-init-env
# b) Run: .\scripts\init-env.ps1
# c) Copy this file to .env and fill in
# NEVER commit .env to source control.
# ============================================

# --- PostgreSQL ---
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=<REDACTED>
POSTGRES_DB=herobm

# --- HeroBM services ---
# BIND_IP=127.0.0.1 # Uncomment and change to 0.0.0.0 to expose services externally
API_PORT=3001
FE_PORT=8000
WORKER_PORT=9092
ADMIN_PASSWORD=<REDACTED>

# --- Redis ---
# REDIS_HOST=localhost
REDIS_PASSWORD=<REDACTED>

# --- Secrets generated during setup ---
JWT_SECRET=<REDACTED>
ENCRYPTION_KEY=<REDACTED>
PIPELINE_SECRET=<REDACTED>


# --- Report Generation ---
# On Windows, provide absolute path to typst.exe if not on system PATH
# Example: TYPST_BINARY_PATH=C:\Users\...\typst.exe
TYPST_BINARY_PATH=typst

# --- Persistent Storage / Media ---
STORAGE_PATH=./data/storage

# --- API docs in UI ---
# ENABLE_SWAGGER=false (defaults to true)

# --- MCP Server ---
# Generate a key in the UI (/admin/developers) and place it here to allow the MCP Server to hit the API.
# WARNING: Any AI agent connected to this MCP server will inherit all permissions granted to this key!
HEROBM_AGENT_KEY=your-generated-secret-key

# --- CORS Configuration ---
# The API restricts CORS origins for security (used when browsers make direct cross-origin calls).
# If you are building a custom frontend SPA (e.g. on port 8080) that connects directly to this API,
# uncomment and set your URL below.
# Note: Next.js (ops-portal) uses a server-side proxy, so it bypasses browser CORS automatically.
# CORS_ORIGINS=http://localhost:8080

ENABLE_CUSTOM_IMPORTS=false

# --- Local Development (dev-local only) ---
# If running 'dev-local' (host machine without docker), uncomment the below lines to point the 
# API to your local uvicorn pipeline runner instance and allow it to send logs back to the API.
# PIPELINE_RUNNER_URL=http://127.0.0.1:8001
# WEBHOOK_URL=http://127.0.0.1:3001/internal/setup/webhook