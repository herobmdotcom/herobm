# ============================================
# HeroBM Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# Or run: .\scripts\init-env.ps1 (auto-generates local secrets)
# NEVER commit .env to source control.
# ============================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REDACTED>
POSTGRES_DB=custom_app

# --- Redis ---
REDIS_PASSWORD=<REDACTED>

# --- Grafana ---
GRAFANA_PASSWORD=<REDACTED>

# --- Custom API ---
JWT_SECRET=<REDACTED>
ENCRYPTION_KEY=<REDACTED>
DEV_ADMIN_PASSWORD=<REDACTED>
DEV_VIEWER_PASSWORD=<REDACTED>
DEV_SALES_PASSWORD=<REDACTED>
DEV_WAREHOUSE_PASSWORD=<REDACTED>
DEV_PROCUREMENT_PASSWORD=<REDACTED>
DEV_FINANCE_PASSWORD=<REDACTED>
CORS_ORIGINS=http://localhost:4300,http://localhost:4400

# --- Report Generation ---
# On Windows, provide absolute path to typst.exe if not on system PATH
# Example: TYPST_BINARY_PATH=C:\Users\...\typst.exe
TYPST_BINARY_PATH=typst

# --- ABM MSSQL Import ---
ABM_MSSQL_HOST=localhost
ABM_MSSQL_DATABASE=abm_db
ABM_MSSQL_USER=sa
ABM_MSSQL_PASSWORD=<REDACTED>  
ENABLE_AU_CUSTOM_FIELDS=false

ENCRYPTION_KEY=0123456789abcdef0123456789abcdef