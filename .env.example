# ============================================
# HeroBM Platform — Environment Variables
# ============================================
# Sets the basic configuration. Do one of:
# a) Run make cli-init-env
# b) Run: .\scripts\init-env.ps1
# c) Copy this file to .env and fill in
# NEVER commit .env to source control.
# ============================================

# --- PostgreSQL ---
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=<REDACTED>
POSTGRES_DB=herobm

# --- Redis ---
# REDIS_HOST=localhost
REDIS_PASSWORD=<REDACTED>

# --- Secrets generated during setup ---
JWT_SECRET=<REDACTED>
ENCRYPTION_KEY=<REDACTED>

# CORS_ORIGINS=http://localhost:4300

# --- Report Generation ---
# On Windows, provide absolute path to typst.exe if not on system PATH
# Example: TYPST_BINARY_PATH=C:\Users\...\typst.exe
TYPST_BINARY_PATH=typst

# --- API docs in UI ---
# ENABLE_SWAGGER=false (defaults to true)