# Ignore heavy directories that are re-created inside the container
**/node_modules
**/dist
**/.next
**/.tsbuildinfo
**/coverage

# Pipeline data (large)
pipelines/abm_extract/.dlt
**/*.pipeline_data

# OS / editor
.git
**/.DS_Store
**/Thumbs.db

# Environment (secrets — never send to build context)
.env
.env.*
.env.local
.env.*.local
.setup-token

# TLS / SSL Certificates
certs/
*.pem
*.key
*.crt
*.p12
*.pfx

# Logs
logs/
**/*.log

# Temp files & agents
/tmp/
**/test-results/
**/playwright-report/
**/.playwright/
.venv/
scratch/
brain/
.agents/
apps/tmp/
apps/api/tmp/

# Large data/backup files
*.tar.gz
*.tar
*.csv

# Reports and test outputs
*.md
portal-test-out.txt
