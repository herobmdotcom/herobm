FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache typst font-dejavu

# To use NPM workspaces effectively in Docker, copy package info first to cache
COPY package.json package-lock.json ./
COPY packages/ ./packages/
COPY apps/api/package*.json ./apps/api/

# Install the monorepo dependencies (this scopes to API and its dependencies due to -w)
RUN npm ci

# Copy the actual source code
COPY apps/api/ ./apps/api/

WORKDIR /app/apps/api
# Skip tests during container build for speed and environmental stability
# RUN npm test
RUN npm run build
RUN npm prune --omit=dev

EXPOSE 3001

# The build output is nested because of the monorepo structure and shared packages
CMD ["node", "dist/apps/api/src/main.js"]
