{
  "name": "herobm-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "libphonenumber-js": "^1.13.6"
  },
  "scripts": {
    "seed": "npm run seed -w apps/api",
    "test": "make test-api",
    "verify": "make verify-local",
    "typecheck": "make typecheck-portal",
    "lint": "npm run lint --workspaces --if-present",
    "knip": "knip",
    "knip-report": "knip --reporter markdown > knip-report.md"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@types/es-aggregate-error": "^1.0.6",
    "knip": "^6.23.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
