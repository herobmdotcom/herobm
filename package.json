{
  "name": "herobm-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "extensions/*"
  ],
  "scripts": {
    "seed": "npm run seed -w apps/api",
    "test": "make test-api",
    "verify": "make verify-local",
    "typecheck": "make typecheck-portal",
    "lint": "npm run lint --workspaces --if-present",
    "knip": "knip",
    "knip-report": "knip --reporter markdown > knip-report.md"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@types/es-aggregate-error": "^1.0.6",
    "knip": "^6.23.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@asyncapi/specs": "^6.11.1",
    "@nestjs/cli": "^11.0.24",
    "es-abstract": "^1.24.2",
    "es-aggregate-error": "^1.0.14"
  }
}
