{
  "name": "herobm-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "libphonenumber-js": "^1.13.6"
  },
  "scripts": {
    "seed": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/scripts/seed.ts",
    "test": "make test-api",
    "verify": "make verify-local",
    "typecheck": "make typecheck-portal",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/es-aggregate-error": "^1.0.6"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
