{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "tsc",
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "dtoFileNameSuffix": ["dto.ts"]
        }
      }
    ],
    "assets": [
      { "include": "auth/casbin/*.conf", "watchAssets": true },
      { "include": "auth/casbin/*.csv", "watchAssets": true },
      { "include": "reports/templates/**/*.typ", "watchAssets": true },
      { "include": "gl/charts/*.json", "watchAssets": true }
    ]
  }
}
