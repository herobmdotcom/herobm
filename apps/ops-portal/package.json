{
  "name": "ops-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-webhooks-content.js",
    "dev": "npx dotenv-cli -e ../../.env -- cross-env-shell \"next dev\"",
    "dev:local": "npx dotenv-cli -e ../../.env -- cross-env-shell \"next dev\"",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/generate-webhooks-content.js && tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "start:prod": "node .next/standalone/apps/ops-portal/server.js",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" && npm run lint:i18n && npm run lint:forms",
    "lint:i18n": "node scripts/lint-i18n.js",
    "lint:forms": "node scripts/lint-forms.js",
    "test": "jest",
    "test:e2e": "playwright test",
    "generate-api": "npx openapi-typescript http://127.0.0.1:3001/api-docs-json -o lib/api-types.ts"
  },
  "dependencies": {
    "@herobm/sdk": "^0.1.0",
    "@herobm/shared": "*",
    "@parcel/watcher": "^2.5.0",
    "ag-grid-community": "^33.2.5",
    "ag-grid-react": "^33.2.5",
    "i18n-iso-countries": "^7.14.0",
    "markdown-it": "^14.2.0",
    "next": "^15.3.3",
    "next-intl": "^4.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.6.0",
    "react-phone-number-input": "^3.4.17",
    "recharts": "^3.8.1",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.7",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "jsonc-eslint-parser": "^3.1.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.1"
  }
}
