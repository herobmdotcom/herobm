  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "paths": {
      "@modbm/erpnext-client": ["../../packages/erpnext-client/src/index.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
