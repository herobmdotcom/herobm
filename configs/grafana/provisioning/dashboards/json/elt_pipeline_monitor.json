{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Last Pipeline Run",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "targets": [
        {
          "rawSql": "SELECT run_ts AS \"time\", status FROM raw_abm._pipeline_metrics ORDER BY run_ts DESC LIMIT 1;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "SUCCESS": { "text": "SUCCESS", "color": "green" }, "FAILED": { "text": "FAILED", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^status$/", "values": false } }
    },
    {
      "id": 2,
      "title": "Load Duration (seconds)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "targets": [
        {
          "rawSql": "SELECT run_ts AS \"time\", duration_s AS \"Duration\" FROM raw_abm._pipeline_metrics ORDER BY run_ts DESC LIMIT 1;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 300, "color": "yellow" }, { "value": 600, "color": "red" }] } },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^Duration$/", "values": false } }
    },
    {
      "id": 3,
      "title": "Tables Loaded",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "targets": [
        {
          "rawSql": "SELECT run_ts AS \"time\", table_count AS \"Tables\" FROM raw_abm._pipeline_metrics ORDER BY run_ts DESC LIMIT 1;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "blue" }] } },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^Tables$/", "values": false } }
    },
    {
      "id": 4,
      "title": "Pipeline Run History",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "targets": [
        {
          "rawSql": "SELECT run_ts AS \"Time\", pipeline AS \"Pipeline\", status AS \"Status\", round(duration_s::numeric, 1) AS \"Duration (s)\", table_count AS \"Tables\", coalesce(error_msg, '-') AS \"Error\" FROM raw_abm._pipeline_metrics ORDER BY run_ts DESC LIMIT 50;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Status" }, "properties": [{ "id": "custom.displayMode", "value": "color-background" }, { "id": "mappings", "value": [{ "type": "value", "options": { "SUCCESS": { "color": "green" }, "FAILED": { "color": "red" } } }] }] }
        ]
      }
    },
    {
      "id": 5,
      "title": "Duration Trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "targets": [
        {
          "rawSql": "SELECT run_ts AS \"time\", duration_s AS \"Duration\" FROM raw_abm._pipeline_metrics WHERE status = 'SUCCESS' ORDER BY run_ts;",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Pipeline Logs (Loki)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "expr": "{job=\"elt_pipelines\"} |= ``",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["elt", "pipeline", "observability"],
  "templating": {
    "list": [
      {
        "name": "DS_POSTGRES",
        "type": "datasource",
        "query": "postgres",
        "current": { "text": "Postgres", "value": "Postgres" },
        "hide": 2
      },
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "Loki", "value": "Loki" },
        "hide": 2
      }
    ]
  },
  "time": { "from": "now-7d", "to": "now" },
  "title": "ELT Pipeline Monitor",
  "uid": "elt-pipeline-monitor"
}
