{
  "$schema": "https://unpkg.com/knip@5/schema-json-bindings.json",
  "workspaces": {
    ".": {
      "ignore": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.e2e-spec.ts",
        "infra/tests/**",
        "infra/heavy_tests/**",
        "infra/test-utils/**",
        "**/scripts/**",
        "**/tools/**",
        "scripts/**",
        "tools/**",
        "apps/api/test/**",
        "apps/api/src/test-utils/**",
        "**/*test*.*",
        "**/jest.config.*",
        "**/jest.setup.*",
        "apps/ops-portal/e2e/**",
        "apps/mcp-server/**"
      ],
      "ignoreDependencies": [
        "@testing-library/*",
        "jest-*",
        "supertest",
        "eslint-*",
        "@types/*",
        "dotenv-cli",
        "cross-env",
        "ts-loader",
        "depcheck",
        "source-map-support",
        "@nestjs/testing",
        "ts-morph"
      ],
      "ignoreBinaries": [
        "cross-env",
        "tsx",
        "make"
      ]
    }
  },
  "rules": {
    "exports": "off",
    "types": "off",
    "enumMembers": "off"
  },
  "jest": false
}
