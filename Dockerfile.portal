# ==============================================================================
# HeroBM Ops-Portal — Multi-stage Container Build
# ==============================================================================
# Builds the Next.js ops-portal in standalone mode for containerised deployment.
# The directory structure mirrors the monorepo layout so that workspace package
# references (../../packages/*) resolve correctly during build.
#
# Build stages use Debian (bookworm-slim) because npm 10.x bundled with
# node:22-alpine cannot self-upgrade and has bugs with cross-platform optional
# dependencies. The final runtime stage uses Alpine for a minimal image.
#
# Final image contains ONLY:
#   - Node.js runtime (alpine, ~50 MB)
#   - server.js + .next/standalone (~20 MB bundled deps)
#   - .next/static (CSS/JS assets)
# The deps and builder stages are discarded after build.
# ==============================================================================

# --- Stage 1: Install dependencies -------------------------------------------
FROM node:22-bookworm-slim AS deps
WORKDIR /app

# Copy workspace metadata for cacheable dependency installation
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/db-schema/package.json ./packages/db-schema/
COPY packages/sdk/package.json ./packages/sdk/
# Only copy package.json for the portal app right now to cache deps
COPY apps/ops-portal/package*.json ./apps/ops-portal/

RUN npm install

# npm ci in monorepo workspaces often skips platform-specific optional
# native binaries. Explicitly install all required ones for the build
# platform. Uses platform detection so the same Dockerfile works on
# Linux (glibc/musl), macOS, and Windows.
RUN set -e && \
    OS=$(node -p process.platform) && \
    ARCH=$(node -p process.arch) && \
    if [ -f /etc/alpine-release ]; then LIBC=musl; PARCEL_LIBC=musl; \
    else LIBC=gnu; PARCEL_LIBC=glibc; fi && \
    npm install --no-save \
      "@parcel/watcher-${OS}-${ARCH}-${PARCEL_LIBC}" \
      "@swc/core-${OS}-${ARCH}-${LIBC}" \
      "lightningcss-${OS}-${ARCH}-${LIBC}" \
      "@tailwindcss/oxide-${OS}-${ARCH}-${LIBC}" \
      "@unrs/resolver-binding-${OS}-${ARCH}-${LIBC}"

# --- Stage 2: Build ----------------------------------------------------------
FROM deps AS builder

# Copy workspace source files needed for build
COPY packages/ ./packages/
COPY apps/ops-portal/ ./apps/ops-portal/
COPY docs/ ./docs/

RUN npm run build -w packages/shared
RUN npm run build -w packages/db-schema
RUN npm run build -w packages/sdk

# Typecheck (quality gate — catches type errors before build)
RUN cd apps/ops-portal && npm run prebuild

# Build the Next.js standalone bundle.
# API_URL must be set at build time because next.config.ts rewrites are baked
# into the standalone output (not resolved at runtime).
ARG API_URL=http://herobm-api:3001
ENV API_URL=${API_URL}
RUN cd apps/ops-portal && npm run build

# --- Stage 3: Production runtime (slim) --------------------------------------
# Debian for maximum DNS reliability (fixes podman/alpine ENOTFOUND bugs).
FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0


# The standalone output bundles all runtime deps into a self-contained directory.
# Only server.js + bundled node_modules + static assets are needed.
COPY --from=builder --chown=node:node /app/apps/ops-portal/.next/standalone ./
COPY --from=builder --chown=node:node /app/apps/ops-portal/.next/static ./apps/ops-portal/.next/static
COPY --from=builder --chown=node:node /app/apps/ops-portal/messages ./apps/ops-portal/messages
COPY --from=builder --chown=node:node /app/apps/ops-portal/public ./apps/ops-portal/public

RUN chown -R node:node /app

USER node

EXPOSE 3000

# In a monorepo, the standalone server.js is nested under the app path
CMD ["node", "apps/ops-portal/server.js"]
