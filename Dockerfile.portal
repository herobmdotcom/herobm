# ==============================================================================
# HeroBM Ops-Portal — Multi-stage Container Build
# ==============================================================================
# Builds the Next.js ops-portal in standalone mode for containerised deployment.
# The directory structure mirrors the monorepo layout so that workspace package
# references (../../packages/*) resolve correctly during build.
#
# Final image contains ONLY:
#   - Node.js runtime (alpine, ~50 MB)
#   - server.js + .next/standalone (~20 MB bundled deps)
#   - .next/static (CSS/JS assets)
# The deps and builder stages are discarded after build.
# ==============================================================================

FROM node:22-bookworm-slim AS base
# Debian Bookworm (glibc) natively supports Next.js SWC, Parcel Watcher, and Turbopack
# without requiring compatibility layers like libc6-compat on Alpine.

# --- Stage 1: Install dependencies -------------------------------------------
FROM base AS deps
WORKDIR /app

# Copy workspace metadata for cacheable dependency installation
COPY package.json package-lock.json ./
COPY packages/ ./packages/
# Only copy package.json for the portal app right now to cache deps
COPY apps/ops-portal/package*.json ./apps/ops-portal/

RUN npm ci

# --- Stage 2: Build ----------------------------------------------------------
FROM base AS builder
WORKDIR /app

# Copy node_modules from deps stage (root and any local ones)
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/apps/ops-portal/node_modules ./apps/ops-portal/node_modules

# Copy workspace source files needed for build
COPY package.json package-lock.json ./
COPY packages/ ./packages/
COPY apps/ops-portal/ ./apps/ops-portal/

# Build workspace packages first (dist is excluded by .dockerignore)
RUN npm run build -w packages/shared
RUN npm run build -w packages/sdk

# Typecheck (quality gate — catches type errors before build)
RUN cd apps/ops-portal && npx tsc --noEmit

# Build the Next.js standalone bundle.
# API_URL must be set at build time because next.config.ts rewrites are baked
# into the standalone output (not resolved at runtime).
ARG API_URL=http://custom-api:3001
ENV API_URL=${API_URL}
RUN cd apps/ops-portal && npm run build

# --- Stage 3: Production runtime (slim) --------------------------------------
# Uses node:22-bookworm-slim to match the builder architecture (glibc)
FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# The standalone output bundles all runtime deps into a self-contained directory.
# Only server.js + bundled node_modules + static assets are needed.
COPY --from=builder /app/apps/ops-portal/.next/standalone ./
COPY --from=builder /app/apps/ops-portal/.next/static ./apps/ops-portal/.next/static
COPY --from=builder /app/apps/ops-portal/messages ./apps/ops-portal/messages
# COPY --from=builder /app/apps/ops-portal/public ./public

EXPOSE 3000

# In a monorepo, the standalone server.js is nested under the app path
CMD ["node", "apps/ops-portal/server.js"]
